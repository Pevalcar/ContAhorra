{
  "cSpell.words": ["vstack"],
  "i18n-ally.extract.ignored": ["bottom right", "Gasto", "Ingreso", "Transferencia", "Préstamo"],
  "i18n-ally.extract.ignoredByFiles": {
    "app\\(drawer)\\index.tsx": ["bottom right"],
    "components\\CustomDrawer.tsx": ["Not find"],
    "components\\Login\\LoginUI.tsx": ["\r\n                Desarrollo\r\n              "],
    "lib\\Hooks\\useLogin.ts": ["Cancelled"]
  },
  "i18n-ally.localesPaths": ["i18n/locales"],
  "i18n-ally.keystyle": "flat",
  "i18n-ally.sourceLanguage": "es",

  "tailwindCSS.experimental.classRegex": [
    ["tva\\((([^()]*|\\([^()]*\\))*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  "exportall.config.folderListener": [
    "/lib/domain/usecases/Auth",
    "/lib/domain/entities",
    "/lib/domain/usecases/Transacciones"
  ]
}
